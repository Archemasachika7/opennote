{
  "$schema": "../node_modules/@tauri-apps/cli/config.schema.json",
  "productName": "OpenNote",
  "version": "../package.json",
  "identifier": "app.opennote.notes",
  "build": {
    "frontendDist": "../dist",
    "devUrl": "http://localhost:5173",
    "beforeDevCommand": "npm run dev",
    "beforeBuildCommand": "npm run build"
  },
  "app": {
    "windows": [
      {
        "title": "OpenNote",
        "width": 1280,
        "height": 840,
        "minWidth": 900,
        "minHeight": 600,
        "resizable": true,
        "fullscreen": false,
        "backgroundColor": "#121318",
        "dragDropEnabled": false
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "nsis"
    ],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "publisher": "OpenNote",
    "shortDescription": "Notebook with handwriting, typed notes and live AI artifact pages",
    "windows": {
      "nsis": {
        "installMode": "currentUser"
      }
    }
  }
}
